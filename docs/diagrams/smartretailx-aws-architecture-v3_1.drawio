        <!-- ═══ RIGHT COLUMN ═══ -->
        <mxCell id="legend" value="&lt;b&gt;HOW TO READ&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1a73e8&quot;&gt;— solid blue&lt;/font&gt;: synchronous request&lt;br&gt;&lt;font color=&quot;#cc6600&quot;&gt;-- dashed orange&lt;/font&gt;: async event / queue&lt;br&gt;&lt;font color=&quot;#BF0816&quot;&gt;-- dashed red&lt;/font&gt;: identity / compensation&lt;br&gt;&lt;font color=&quot;#FF6600&quot;&gt;▬ thick orange&lt;/font&gt;: EventBridge Pipes ★&lt;br&gt;①–⑩ lifecycle · ★ differentiator · ADR-n decision" style="text;html=1;strokeColor=#666666;fillColor=#fafafa;rounded=1;fontSize=10;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="1740" y="90" width="540" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="lifecycle" value="&lt;b&gt;REQUEST LIFECYCLE ①–⑩&lt;/b&gt;&lt;br&gt;① Login via Cognito Hosted UI (OAuth2 code + PKCE) → JWT&lt;br&gt;② SPA runtime config → CloudFront over HTTPS with Bearer JWT&lt;br&gt;③ CloudFront routes /v1/* → HTTP API · static → versioned S3 release&lt;br&gt;④ JWT authoriser validates via JWKS · RBAC via cognito:groups&lt;br&gt;⑤ VPC Link → internal ALB → path-routed service&lt;br&gt;⑥ Order: idempotency + atomic DDB order/outbox transaction&lt;br&gt;⑦ Stream publisher → SQS; Inventory inbox/outbox + Aurora transaction&lt;br&gt;⑧ Outcome SNS → compensation; DDB Streams → Pipes → EventBridge&lt;br&gt;⑨ Notification λ + user-scoped WebSocket push&lt;br&gt;⑩ Correlation + OTel → ADOT/X-Ray; logs/alarms → CloudWatch" style="text;html=1;strokeColor=#0066cc;fillColor=#f5faff;rounded=1;fontSize=10;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="1740" y="270" width="540" height="250" as="geometry"/>
        </mxCell>

