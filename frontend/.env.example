# Copy this file to `.env` and fill in the values for local dev.
#
# CRITICAL: these are consumed by Vite at BUILD time (import.meta.env.*).
# Changing them requires a rebuild; the deployed SPA cannot pick up new
# values from a live config endpoint. This is by design - a client-side
# runtime config would need an extra HTTP round-trip on first paint and
# introduces a whole-app failure mode if the config endpoint is slow.
# See frontend/README.md for the trade-off write-up.

# Where the SPA sends /v1/... API calls. In prod this is the CloudFront
# domain (the /api/* behaviour proxies to the HTTP API); locally it is
# the HTTP API endpoint directly (Terraform output api_endpoint).
VITE_API_BASE_URL=http://localhost:8000

# Cognito Hosted UI OIDC discovery root. Format:
#   https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
# NOT the Hosted UI login URL - react-oidc-context reads
# .well-known/openid-configuration below the authority.
VITE_COGNITO_AUTHORITY=https://cognito-idp.eu-west-1.amazonaws.com/<user-pool-id>

# The SPA (public) app client id from Terraform output
# `cognito_app_client_id`. There is NO client secret - Cognito SPA
# clients cannot store one and PKCE replaces the confidential client
# assumption for public clients.
VITE_COGNITO_CLIENT_ID=<app-client-id>

# Where Cognito redirects back after login. Must be in the
# callback_urls list on the app client (Terraform seeds
# http://localhost:5173/callback and https://<cf-domain>/callback).
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/callback

# WebSocket endpoint for real-time order status updates.
# Terraform output `websocket_endpoint`, e.g.
#   wss://<api-id>.execute-api.eu-west-1.amazonaws.com/prod
# The SPA appends ?token=<access_token> automatically (WebSocket
# handshakes cannot set an Authorization header, so the custom
# Lambda authoriser reads the token off the query string).
VITE_WEBSOCKET_URL=wss://<ws-api-id>.execute-api.eu-west-1.amazonaws.com/prod
